PORT=
# MongoDB Connection (Local or MongoDB Atlas)
# Ví dụ Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatapp?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=chatapp
# Redis Connection (Local or Upstash Cloud)
# Ví dụ Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=
NODE_ENV=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin & Access Control
ADMIN_EMAILS=

# Cloudflare Turnstile & Anti-DDoS WAF
SECRET_KEY_CLOUDFLARE=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
WAF_CLEARANCE_SECRET=
# Bật cờ này trên Production để chặn 100% kết nối quét trực tiếp vào IP máy chủ (bắt buộc qua Cloudflare WAF):
CLOUDFLARE_PROXY_ONLY=
# Cloudflare API Token & Zone ID (Dành cho WAF-as-Code CLI và đồng bộ WAF tự động)
# Yêu cầu quyền API Token: Zone.Zone Settings (Edit), Zone.Firewall Services (Edit), Zone.Bot Management (Edit)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FRONTEND_HOST=
CLOUDFLARE_API_HOST=
# Tự động đẩy IP vi phạm nhiều lần lên Cloudflare IP Access Rules (chặn tại Edge)
CLOUDFLARE_AUTO_BAN=
# Proxy nội bộ được tin để đọc cf-connecting-ip / x-forwarded-for (ngoài dải IP Cloudflare luôn được tin).
# TRUSTED_PROXY_CIDRS=
# Token kết nối Cloudflare Zero Trust Tunnel:
CLOUDFLARE_TUNNEL_TOKEN=
# Cấu hình CORS cho Domain Cloudflare:
FRONTEND_URL=
CORS_ORIGIN=

# Mail SMTP Configuration (e.g. Gmail)
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Neo4j Graph Database (Local or Neo4j Aura Cloud)
# Ví dụ Aura: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=

# Groq Cloud API Key (Tóm tắt bình luận, tóm tắt tin nhắn & Bot Aura AI) - https://console.groq.com/keys
GROQ_API_KEY=
# Tên mô hình Groq (mặc định llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# MQTT & SSL/TLS Configuration (Mã hóa đường truyền WSS/MQTTS chống bắt gói tin)
MQTT_PORT=
MQTT_WSS_PORT=
MQTT_TLS_PORT=
MQTT_REQUIRE_AUTH=
# Đường dẫn tệp chứng chỉ:
MQTT_TLS_KEY_PATH=
MQTT_TLS_CERT_PATH=
# Hoặc truyền trực tiếp qua chuỗi PEM trên máy chủ Production:
# MQTT_TLS_KEY=
# MQTT_TLS_CERT=

# ==============================================================================
# AWS S3 Cloud Storage & Amazon Rekognition AI Moderation
# Selected Region: ap-southeast-2 (Sydney)
# ==============================================================================
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=chatapp-media-703002395048-ap-southeast-2
AWS_PROFILE=default

# AWS Credentials (Tuỳ chọn: Khóa API tĩnh IAM User nếu không dùng session login)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
