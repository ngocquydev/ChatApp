PORT=3000
MONGODB_URI=mongodb://localhost:27017/chatapp
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare Turnstile & Anti-DDoS WAF
SECRET_KEY_CLOUDFLARE=
# Bật cờ này trên Production để chặn 100% kết nối quét trực tiếp vào IP máy chủ (bắt buộc qua Cloudflare WAF):
CLOUDFLARE_PROXY_ONLY=false
# Token kết nối Cloudflare Zero Trust Tunnel:
CLOUDFLARE_TUNNEL_TOKEN=
# Cấu hình CORS cho Domain Cloudflare:
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=https://chat.yourdomain.com,https://api.yourdomain.com

# Mail SMTP Configuration (e.g. Gmail)
# Note: For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ChatApp Security" <your_email@gmail.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# MQTT & SSL/TLS Configuration (Mã hóa đường truyền WSS/MQTTS chống bắt gói tin)
MQTT_PORT=1884
MQTT_WSS_PORT=8884
MQTT_TLS_PORT=8883
MQTT_REQUIRE_AUTH=false
# Đường dẫn tệp chứng chỉ (Mặc định tự tìm trong backend/certs/):
MQTT_TLS_KEY_PATH=certs/mqtt-key.pem
MQTT_TLS_CERT_PATH=certs/mqtt-cert.pem
# Hoặc truyền trực tiếp qua chuỗi PEM trên máy chủ Production:
# MQTT_TLS_KEY="-----BEGIN PRIVATE KEY-----\n..."
# MQTT_TLS_CERT="-----BEGIN CERTIFICATE-----\n..."

