# ==============================================================================
# CHATAPP ADMIN PORTAL - ENVIRONMENT TEMPLATE (apps/admin/.env.example)
# Note: By default, apps/admin automatically loads the unified root ../../.env.local
# You only need apps/admin/.env.local if deploying apps/admin standalone.
# ==============================================================================

PORT_ADMIN=5174
VITE_BACKEND_URL=http://localhost:3000

# Cloudflare Turnstile (Public Site Key)
VITE_TURNSTILE_SITE_KEY=
VITE_SITE_KEY=

# Firebase Client SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Default Admin Credentials (Development Only)
VITE_DEFAULT_ADMIN_EMAIL=
VITE_DEFAULT_ADMIN_PASSWORD=

