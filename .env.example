# ==============================================================================
# CHATAPP - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and update with your actual credentials:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System, Ports & Service URLs
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
PORT_BACKEND=3000
PORT_FE=5173
PORT_ADMIN=5174

# Frontend Client Public URLs
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

ENABLE_SWAGGER=false
ADMIN_EMAILS=admin@chatapp.internal

# ------------------------------------------------------------------------------
# 2. Database & Caches (MongoDB, Redis, Neo4j)
# ------------------------------------------------------------------------------
# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/chatapp
MONGODB_DB_NAME=chatapp

# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
WAF_CLEARANCE_SECRET=your_waf_clearance_secret_min_32_chars

# ------------------------------------------------------------------------------
# 4. Cloudflare Turnstile, WAF & Anti-Bot Protection
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFAake_dummy_site_key
NEXT_PUBLIC_SITE_KEY=0x4AAAAAAFAake_dummy_site_key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFAake_dummy_site_key
VITE_SITE_KEY=0x4AAAAAAFAake_dummy_site_key
TURNSTILE_SITE_KEY=0x4AAAAAAFAake_dummy_site_key

TURNSTILE_SECRET=0x4AAAAAAFAake_dummy_secret_key
TURNSTILE_SECRET_KEY=0x4AAAAAAFAake_dummy_secret_key
SECRET_KEY_CLOUDFLARE=0x4AAAAAAFAake_dummy_secret_key
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FRONTEND_HOST=localhost
CLOUDFLARE_API_HOST=localhost
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PROXY_ONLY=false
CLOUDFLARE_AUTO_BAN=false

# ------------------------------------------------------------------------------
# 5. Firebase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-app
VITE_FIREBASE_PROJECT_ID=your-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

FIREBASE_PROJECT_ID=your-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. Amazon Rekognition AI Moderation (Tuỳ chọn)
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# 7. Cloudinary Media Storage
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 8. AI & Large Language Models (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 9. MQTT Broker & Realtime TLS
# ------------------------------------------------------------------------------
MQTT_PORT=1884
MQTT_WSS_PORT=8884
MQTT_TLS_PORT=8883
NEXT_PUBLIC_MQTT_USE_SSL=false

# ------------------------------------------------------------------------------
# 10. SMTP Mailer Configuration
# ------------------------------------------------------------------------------
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ChatApp Security <your_email@gmail.com>"

# ------------------------------------------------------------------------------
# 11. Third-Party Integrations & Admin Credentials
# ------------------------------------------------------------------------------
NEXT_GIPHY_API_KEY=your_giphy_api_key
NEXT_PUBLIC_GIPHY_API_KEY=your_giphy_api_key
VITE_DEFAULT_ADMIN_EMAIL=admin@chatapp.internal
VITE_DEFAULT_ADMIN_PASSWORD=Password123@
