{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "ci:backend": {
      "inputs": [
        "apps/server/**",
        ".github/scripts/ci-inspect.mjs",
        "package.json",
        "package-lock.json",
        "!apps/server/node_modules/**",
        "!apps/server/dist/**",
        "!apps/server/.turbo/**"
      ],
      "tags": ["ci"]
    },
    "ci:server": {
      "inputs": [
        "apps/server/**",
        ".github/scripts/ci-inspect.mjs",
        "package.json",
        "package-lock.json",
        "!apps/server/node_modules/**",
        "!apps/server/dist/**",
        "!apps/server/.turbo/**"
      ],
      "tags": ["ci"]
    },
    "ci:frontend": {
      "inputs": [
        "apps/web/**",
        "package.json",
        "package-lock.json",
        "!apps/web/node_modules/**",
        "!apps/web/.next/**",
        "!apps/web/.turbo/**"
      ],
      "tags": ["ci"]
    },
    "ci:web": {
      "inputs": [
        "apps/web/**",
        "package.json",
        "package-lock.json",
        "!apps/web/node_modules/**",
        "!apps/web/.next/**",
        "!apps/web/.turbo/**"
      ],
      "tags": ["ci"]
    },
    "ci:admin": {
      "inputs": [
        "apps/admin/**",
        "package.json",
        "package-lock.json",
        "!apps/admin/node_modules/**",
        "!apps/admin/dist/**",
        "!apps/admin/.turbo/**"
      ],
      "tags": ["ci"]
    }
  }
}
